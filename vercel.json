{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build && npm test",
      "outputDirectory": "dist/client",
      "functions": { "api/index.js": { "maxDuration": 30 } },
      "routes": [
        { "src": "/api(?:/.*)?", "dest": "/api/index" },
        { "handle": "filesystem" },
        { "src": "/[^.]*", "dest": "/index.html" }
      ]
    },
    "malware-scanner": {
      "root": "scanner",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "functions": { "Dockerfile.vercel": { "maxDuration": 300 } }
    }
  },
  "rewrites": [
    { "source": "/internal/malware-scan/:path*", "destination": { "service": "malware-scanner" } },
    { "source": "/api/:path*", "destination": { "service": "frontend" } },
    { "source": "/:path*", "destination": { "service": "frontend" } }
  ]
}

