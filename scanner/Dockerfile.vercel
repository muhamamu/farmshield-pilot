FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends clamav-daemon clamav-freshclam gosu ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY clamd.conf /etc/clamav/clamd.conf
COPY server.mjs start.sh ./
RUN chmod 755 /app/start.sh \
  && mkdir -p /var/lib/clamav /run/clamav \
  && chown -R clamav:clamav /var/lib/clamav /run/clamav \
  && (freshclam --stdout --quiet || true)

ENV NODE_ENV=production
CMD ["/app/start.sh"]

