# Evaluation endpoint is for prototype evaluation, not a commercial rollout.
WEATHER_ACCESS_MODE=evaluation
# Set mode=commercial and provide the paid key before commercial use.
OPEN_METEO_API_KEY=
# Server-only. Never prefix secrets with VITE_.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public business support address shown on policy pages (not a secret).
VITE_SUPPORT_EMAIL=
